  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@picocss/pico": "^2.1.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
